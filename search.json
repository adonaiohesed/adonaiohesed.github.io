---
layout: none
---
[
  {% for post in site.posts %}
    {
      "title"    : {{ post.title | escape_once | jsonify }},
      "title_kr" : {% include bilingual-post-text.html post=post field='search_title_kr' %},
      "category" : {{ post.categories | join: ', ' | escape | jsonify }},
      {% capture category_kr %}{% for category in post.categories %}{% assign category_locale = site.data.category_locales[category] %}{{ category_locale.title | default: category }}{% unless forloop.last %}, {% endunless %}{% endfor %}{% endcapture %}
      "category_kr" : {{ category_kr | escape_once | jsonify }},
      "url"      : {{ post.url | relative_url | jsonify }},
      "date"     : "{{ post.date | date: '%B %d, %Y' }}",
      "date_kr"  : "{{ post.date | date: '%Y년 %-m월 %-d일' }}"
    }{% if forloop.last == false %},{% endif %}
  {% endfor %}
  
  {% if site.projects.size > 0 %}
    {% if site.posts.size > 0 %},{% endif %}
    {% for project in site.projects %}
      {% assign project_id = project.path | split: '/' | last | remove: '.md' %}
      {
        "title"    : {{ project.title | escape | jsonify }},
        "title_kr" : {{ project.title | escape | jsonify }},
        "category" : "Project",
        "category_kr" : "프로젝트",
        "url"      : {{ '/portfolio/#project-' | append: project_id | relative_url | jsonify }},
        "date"     : "Project",
        "date_kr"  : "프로젝트"
      }{% if forloop.last == false %},{% endif %}
    {% endfor %}
  {% endif %}

  {% if site.ctfs.size > 0 %}
    {% if site.posts.size > 0 or site.projects.size > 0 %},{% endif %}
    {% for ctf in site.ctfs %}
      {% assign ctf_id = ctf.path | split: '/' | last | remove: '.md' %}
      {
        "title"    : {{ ctf.title | escape | jsonify }},
        "title_kr" : {{ ctf.title | escape | jsonify }},
        "category" : "CTF",
        "category_kr" : "CTF",
        "url"      : {{ '/portfolio/#ctf-' | append: ctf_id | relative_url | jsonify }},
        "date"     : "CTF",
        "date_kr"  : "CTF"
      }{% if forloop.last == false %},{% endif %}
    {% endfor %}
  {% endif %}
]
